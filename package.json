{
  "name": "geniffy",
  "version": "0.4.0",
  "description": "Geniffy for TypeScript and JavaScript: add notes, files and links to a memory, then search it and ask it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/client.test.mjs test/claude.test.mjs test/briefing.test.mjs test/session-usage.test.mjs"
  },
  "keywords": ["memory", "ai", "agents", "llm", "rag", "geniffy", "claude", "memory-tool"],
  "homepage": "https://docs.geniffy.com/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geniffy/geniffy-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Geniffy/geniffy-typescript/issues"
  },
  "author": "Geniffy <ops@geniffy.com>",
  "license": "MIT",
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "typescript": "^5.6.0"
  }
}
